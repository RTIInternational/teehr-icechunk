<mxfile host="Electron" type="device"><diagram id="page-0" name="Two paths: inputs and outputs"><mxGraphModel dx="1560" dy="960" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="960" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="grp-build" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeWidth=2;dashPattern=8 8;strokeColor=#363636;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1520" height="290" as="geometry"/></mxCell><mxCell id="grp-build-label" value="1. Repo building: source files in, a spec repo out" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=default;fontSize=14;fontStyle=1;fontColor=#363636;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="420" height="30" as="geometry"/></mxCell><mxCell id="in-source" value='&lt;b&gt;Source&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;GriddedSource / IndexSource: where the files are, time grid and axes, variables, dataset settings&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="290" height="70" as="geometry"/></mxCell><mxCell id="in-run" value='&lt;b&gt;Run request&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Window (start/end or lookback); append / upsert; tiers: references, + data, + overviews; fan-out (max_child_runs)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="290" height="80" as="geometry"/></mxCell><mxCell id="in-target" value='&lt;b&gt;Target storage&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Icechunk storage: bucket and prefix&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="290" height="60" as="geometry"/></mxCell><mxCell id="ingest" value='&lt;b&gt;ingest(...)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;List and select steps → prepare (groups, axes, NOT_EXPECTED) → plan units → run units (in-process, Prefect, or another runner) → record steps&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="420" y="120" width="560" height="120" as="geometry"/></mxCell><mxCell id="out-repo" value='&lt;b&gt;Icechunk repo (spec layout)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;/references, optional /data, /overviews/&amp;lt;factor&amp;gt;; step metadata; CF / GeoZarr attributes&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1070" y="80" width="440" height="130" as="geometry"/></mxCell><mxCell id="out-report" value='&lt;b&gt;Run report&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Units written or failed (retried by the next run)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="420" y="260" width="560" height="50" as="geometry"/></mxCell><mxCell id="e-b-in0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="in-source" target="ingest"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-b-in1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="in-run" target="ingest"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-b-in2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="in-target" target="ingest"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-b-repo" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="ingest" target="out-repo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-b-rep" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ingest" target="out-report"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="read" value='&lt;b&gt;Read layer&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Repo contract (spec), read_grid_spec, open_grid_dataset: our repos, or external ones with a spec override&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1070" y="360" width="440" height="70" as="geometry"/></mxCell><mxCell id="e-repo-read" value="reads" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="out-repo" target="read"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="grp-zonal" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeWidth=2;dashPattern=8 8;strokeColor=#363636;" vertex="1" parent="1"><mxGeometry x="20" y="470" width="1520" height="320" as="geometry"/></mxCell><mxCell id="grp-zonal-label" value="2. Zonal statistics: a dataset and polygons in, Arrow batches out" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=default;fontSize=14;fontStyle=1;fontColor=#363636;" vertex="1" parent="1"><mxGeometry x="40" y="456" width="540" height="30" as="geometry"/></mxCell><mxCell id="in-ds" value='&lt;b&gt;Dataset&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;One variable from open_grid_dataset (our repos, dynamical.org, AORC ...)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="290" height="70" as="geometry"/></mxCell><mxCell id="in-poly" value='&lt;b&gt;Polygons&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Key + EPSG:4326 geometry, e.g. a v1 location layer&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="290" height="60" as="geometry"/></mxCell><mxCell id="in-sel" value='&lt;b&gt;Selection and settings&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Window, or cycles and members; memory budget; minimum coverage; scale / offset; runner&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="290" height="80" as="geometry"/></mxCell><mxCell id="weights" value="&lt;b&gt;weights_for_grid(...)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Pixel coverage of each polygon (exactextract), on the grid's CRS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="420" y="500" width="270" height="80" as="geometry"/></mxCell><mxCell id="w-table" value='&lt;b&gt;Weights&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Key, row, col, fraction covered; grid_name. Stored by the caller (v1 dataset or cached Parquet; open)&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="420" y="620" width="270" height="110" as="geometry"/></mxCell><mxCell id="zonal" value='&lt;b&gt;zonal_means(...)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Written steps → read plans from the chunk layout → block kernel (cos-latitude area weights) → runner: in-process, Prefect, or Spark mapInArrow&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="760" y="560" width="270" height="140" as="geometry"/></mxCell><mxCell id="out-batches" value='&lt;b&gt;Arrow batches&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;key, value_time, [reference_time], [member], [lead_time], value&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1090" y="560" width="200" height="110" as="geometry"/></mxCell><mxCell id="out-client" value='&lt;b&gt;Client (hub, fved, fetch package)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Maps batches to teehr names and units (by window for windowed variables) and writes v1 timeseries through teehr_core.warehouse&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1310" y="545" width="210" height="140" as="geometry"/></mxCell><mxCell id="e-z-ds-w" value="grid template" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="in-ds" target="weights"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-z-poly" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="in-poly" target="weights"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-z-w" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="weights" target="w-table"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-z-wz" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="w-table" target="zonal"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-z-ds" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;exitX=1;exitY=0.85;entryX=0;entryY=0.29;" edge="1" parent="1" source="in-ds" target="zonal"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="370" y="570"/><mxPoint x="370" y="600"/></Array></mxGeometry></mxCell><mxCell id="e-z-sel" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;exitX=1;exitY=0.8;entryX=0.5;entryY=1;" edge="1" parent="1" source="in-sel" target="zonal"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="360" y="764"/><mxPoint x="895" y="764"/></Array></mxGeometry></mxCell><mxCell id="e-z-out" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="zonal" target="out-batches"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-z-client" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="out-batches" target="out-client"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-read-ds" value="opens" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="read" target="in-ds"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="185" y="395"/></Array></mxGeometry></mxCell><mxCell id="legend" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="260" height="124" as="geometry"/></mxCell><mxCell id="legend-title" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="825" width="100" height="20" as="geometry"/></mxCell><mxCell id="legend-sw0" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="52" y="852" width="28" height="18" as="geometry"/></mxCell><mxCell id="legend-tx0" value="Given by the caller" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="88" y="849" width="208" height="24" as="geometry"/></mxCell><mxCell id="legend-sw1" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="52" y="880" width="28" height="18" as="geometry"/></mxCell><mxCell id="legend-tx1" value="teehr-icechunk" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="88" y="877" width="208" height="24" as="geometry"/></mxCell><mxCell id="legend-sw2" value="" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="52" y="908" width="28" height="18" as="geometry"/></mxCell><mxCell id="legend-tx2" value="Data produced" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="88" y="905" width="208" height="24" as="geometry"/></mxCell><mxCell id="scope" value="teehr-icechunk works on arrays only: it never writes the warehouse or knows TEEHR's data model" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="420" y="340" width="600" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-1" name="Package boundaries"><mxGraphModel dx="1520" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="820" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sources" value='&lt;b&gt;Source files&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;NetCDF / HDF5, GeoTIFF, GRIB2&lt;br&gt;(NOAA, NASA, universities)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#363636;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="200" height="90" as="geometry"/></mxCell><mxCell id="grp-ic" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeWidth=2;dashPattern=8 8;strokeColor=#363636;" vertex="1" parent="1"><mxGeometry x="320" y="60" width="560" height="330" as="geometry"/></mxCell><mxCell id="grp-ic-label" value="teehr-icechunk (arrays only; no TEEHR data model)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=default;fontSize=14;fontStyle=1;fontColor=#363636;" vertex="1" parent="1"><mxGeometry x="340" y="46" width="412" height="30" as="geometry"/></mxCell><mxCell id="repo" value='&lt;b&gt;Repo building&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Sources and the NWM configuration catalog, time grid, references, /data, overviews&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="350" y="100" width="160" height="130" as="geometry"/></mxCell><mxCell id="read" value='&lt;b&gt;Reading&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Repo contract (spec), read_grid_spec, open_grid_dataset; our repos and external ones&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="530" y="100" width="160" height="130" as="geometry"/></mxCell><mxCell id="zonal" value='&lt;b&gt;Zonal statistics&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;weights_for_grid (exactextract coverage); zonal_means → Arrow batches&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="710" y="100" width="150" height="130" as="geometry"/></mxCell><mxCell id="extras" value="&lt;b&gt;Extras:&lt;/b&gt; [hdf] [tiff] [grib] [mean-areal] [prefect]. The base install has no Prefect, teehr or Spark" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="350" y="250" width="510" height="40" as="geometry"/></mxCell><mxCell id="ic-note" value="N-D arrays, gridded or per feature (e.g. NWM streamflow over feature_id)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="350" y="300" width="510" height="30" as="geometry"/></mxCell><mxCell id="repos" value='&lt;b&gt;Icechunk repos&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;/references → /data → /overviews/&amp;lt;factor&amp;gt;&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="500" y="470" width="200" height="110" as="geometry"/></mxCell><mxCell id="grp-clients" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeWidth=2;dashPattern=8 8;strokeColor=#363636;" vertex="1" parent="1"><mxGeometry x="980" y="60" width="520" height="210" as="geometry"/></mxCell><mxCell id="grp-clients-label" value="Client deployments" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=default;fontSize=14;fontStyle=1;fontColor=#363636;" vertex="1" parent="1"><mxGeometry x="1000" y="46" width="164" height="30" as="geometry"/></mxCell><mxCell id="hub" value='&lt;b&gt;teehr-hub&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Sources (NWM forcing), input models, Prefect flows and deployments&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1005" y="100" width="230" height="90" as="geometry"/></mxCell><mxCell id="fved" value='&lt;b&gt;teehr-fved&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Sources (snow), input models, Prefect flows and deployments&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1250" y="100" width="230" height="90" as="geometry"/></mxCell><mxCell id="client-note" value="Mean areal ingest: polygon layers in; Arrow batches mapped to teehr names and units and written" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1005" y="200" width="475" height="50" as="geometry"/></mxCell><mxCell id="fetch" value='&lt;b&gt;Fetch package (ADR-0015)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Tabular sources (USGS, RFC); NWM streamflow read from our repos; gridded weights and means through teehr-icechunk&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="980" y="470" width="280" height="110" as="geometry"/></mxCell><mxCell id="warehouse" value="&lt;b&gt;Warehouse (v1)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Written through teehr-core's shared writer, teehr_core.warehouse (ADR-0019)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1320" y="470" width="180" height="110" as="geometry"/></mxCell><mxCell id="core" value='&lt;b&gt;teehr-cloud-core&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;xpublish-api: map tiles and EDR from the repos; Spark executor image&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="470" width="260" height="90" as="geometry"/></mxCell><mxCell id="community" value='&lt;b&gt;Community readers&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;xarray, notebooks, other tools&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#363636;" vertex="1" parent="1"><mxGeometry x="20" y="640" width="260" height="70" as="geometry"/></mxCell><mxCell id="e-src" value="listed and&lt;br&gt;referenced" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="sources" target="repo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-build" value="builds and updates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="repo" target="repos"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-read" value="reads" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;exitX=0.5;exitY=1;entryX=0.6;entryY=0;" edge="1" parent="1" source="read" target="repos"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-zonal" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="zonal" target="read"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="785" y="80"/><mxPoint x="610" y="80"/></Array></mxGeometry></mxCell><mxCell id="e-clients" value="depend on&lt;br&gt;(pinned by SHA)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;exitX=0;exitY=0.4;entryX=1;entryY=0.25;" edge="1" parent="1" source="grp-clients" target="grp-ic"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-fetch" value="depends on" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;exitX=0;exitY=0.5;entryX=1;entryY=0.85;" edge="1" parent="1" source="fetch" target="grp-ic"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="525"/><mxPoint x="930" y="340"/></Array></mxGeometry></mxCell><mxCell id="e-wh-clients" value="v1 timeseries" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;exitX=0.88;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="grp-clients" target="warehouse"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-wh-fetch" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="fetch" target="warehouse"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-core" value="serves" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="core" target="repos"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-community" value="read (spec)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;exitX=1;exitY=0.5;entryX=0.3;entryY=1;" edge="1" parent="1" source="community" target="repos"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arrows" value="Arrows point at what is depended on, read or written. The target design (see the plan for status)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="980" y="610" width="280" height="40" as="geometry"/></mxCell><mxCell id="legend" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1300" y="610" width="200" height="208" as="geometry"/></mxCell><mxCell id="legend-title" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1310" y="615" width="100" height="20" as="geometry"/></mxCell><mxCell id="legend-sw0" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1312" y="642" width="28" height="18" as="geometry"/></mxCell><mxCell id="legend-tx0" value="teehr-icechunk" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1348" y="639" width="148" height="24" as="geometry"/></mxCell><mxCell id="legend-sw1" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1312" y="670" width="28" height="18" as="geometry"/></mxCell><mxCell id="legend-tx1" value="Client deployment (teehr-hub, teehr-fved)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1348" y="667" width="148" height="24" as="geometry"/></mxCell><mxCell id="legend-sw2" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1312" y="698" width="28" height="18" as="geometry"/></mxCell><mxCell id="legend-tx2" value="Shared core (teehr-cloud-core)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1348" y="695" width="148" height="24" as="geometry"/></mxCell><mxCell id="legend-sw3" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1312" y="726" width="28" height="18" as="geometry"/></mxCell><mxCell id="legend-tx3" value="Fetch package (ADR-0015)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1348" y="723" width="148" height="24" as="geometry"/></mxCell><mxCell id="legend-sw4" value="" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1312" y="754" width="28" height="18" as="geometry"/></mxCell><mxCell id="legend-tx4" value="Storage" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1348" y="751" width="148" height="24" as="geometry"/></mxCell><mxCell id="legend-sw5" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#363636;" vertex="1" parent="1"><mxGeometry x="1312" y="782" width="28" height="18" as="geometry"/></mxCell><mxCell id="legend-tx5" value="External" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1348" y="779" width="148" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-2" name="Repo layout"><mxGraphModel dx="1300" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="700" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="refs" value='&lt;b&gt;/references&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Virtual chunks pointing into the source files; always written&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="260" height="110" as="geometry"/></mxCell><mxCell id="data" value='&lt;b&gt;/data&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Optional materialized copy, rechunked and sharded for fast reads&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="60" width="260" height="110" as="geometry"/></mxCell><mxCell id="ov" value='&lt;b&gt;/overviews/&amp;lt;factor&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Block means for zoomed-out map tiles, e.g. 2, 4, 8&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="720" y="60" width="260" height="110" as="geometry"/></mxCell><mxCell id="e-rd" value="materialize&lt;br&gt;(stale steps)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="refs" target="data"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-do" value="overviews of the&lt;br&gt;data group" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="data" target="ov"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dg" value="Readers use the root &lt;b&gt;data_group&lt;/b&gt; attribute: /data when materialized, else /references" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="940" height="30" as="geometry"/></mxCell><mxCell id="dims" value='&lt;b&gt;Dims&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;&lt;b&gt;Analysis:&lt;/b&gt; (time, y, x) or (time, feature_id)&lt;br&gt;&lt;b&gt;Forecast:&lt;/b&gt; (reference_time, [member], lead_time, y, x)&lt;br&gt;lead_time in int hours; value_time is a 2-D coordinate on (reference_time, lead_time)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="460" height="120" as="geometry"/></mxCell><mxCell id="steps" value='&lt;b&gt;Per-step metadata (coordinates on the step dims)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;&lt;b&gt;status&lt;/b&gt;: -2 not expected, -1 unwritten, 0 early, 1 provisional, 2 stable&lt;br&gt;&lt;b&gt;created_at, updated_at, source_last_modified&lt;/b&gt;: drive upserts and downstream staleness&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="520" y="250" width="460" height="120" as="geometry"/></mxCell><mxCell id="attrs" value='&lt;b&gt;Root attributes&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;append_dim, time_origin, time_step (the fixed time grid); fixed_dims, layout_version; configuration_name, timeseries_type, grid_name, data_group&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="940" height="80" as="geometry"/></mxCell><mxCell id="grid" value="Every step has a slot on the fixed time grid (time_origin + k × time_step), so steps can be written in any order, rewritten (upsert), and resumed after a failed run" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="940" height="40" as="geometry"/></mxCell><mxCell id="spec" value="Defined in spec/gridded-repo-contract.md; tests/fixtures/*_golden.json pin what each shape stores" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="940" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-3" name="Gridded workflow"><mxGraphModel dx="1500" dy="640" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="640" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="src" value='&lt;b&gt;Source files&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;HDF5 / NetCDF, GeoTIFF, GRIB2 + .idx&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#363636;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="180" height="80" as="geometry"/></mxCell><mxCell id="list" value='&lt;b&gt;List and select&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Source listing by step; append / upsert against the stored step metadata&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="240" y="60" width="200" height="80" as="geometry"/></mxCell><mxCell id="prep" value='&lt;b&gt;Prepare (parent)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Groups, axes and root attributes; NOT_EXPECTED slots; one commit&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="480" y="60" width="200" height="80" as="geometry"/></mxCell><mxCell id="plan" value='&lt;b&gt;Plan units&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Whole shards and manifest splits along the append axis&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="720" y="60" width="200" height="80" as="geometry"/></mxCell><mxCell id="run" value='&lt;b&gt;Runner&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;In-process (daily runs) or Prefect child runs (backfills)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="960" y="60" width="200" height="80" as="geometry"/></mxCell><mxCell id="meta" value='&lt;b&gt;Record steps (parent)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Status and audit times of the units that succeeded; one commit&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1200" y="60" width="260" height="80" as="geometry"/></mxCell><mxCell id="e-flow0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="src" target="list"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-flow1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="list" target="prep"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-flow2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="prep" target="plan"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-flow3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="plan" target="run"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-flow4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="run" target="meta"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="grp-unit" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeWidth=2;dashPattern=8 8;strokeColor=#363636;" vertex="1" parent="1"><mxGeometry x="240" y="200" width="920" height="150" as="geometry"/></mxCell><mxCell id="grp-unit-label" value="A unit's stages (each writes chunks only and commits with rebase)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=default;fontSize=14;fontStyle=1;fontColor=#363636;" vertex="1" parent="1"><mxGeometry x="260" y="186" width="540" height="30" as="geometry"/></mxCell><mxCell id="refs" value='&lt;b&gt;/references&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;IdxRefs (GRIB2 .idx) or ParserRefs (HDF5 / NetCDF, GeoTIFF, Zarr), written with set_virtual_refs&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="270" y="230" width="260" height="100" as="geometry"/></mxCell><mxCell id="data" value='&lt;b&gt;/data (optional)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Materialized copy, rechunked and sharded&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="580" y="230" width="240" height="100" as="geometry"/></mxCell><mxCell id="ov" value='&lt;b&gt;/overviews/&amp;lt;factor&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Block means for zoomed-out tiles&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="870" y="230" width="260" height="100" as="geometry"/></mxCell><mxCell id="e-rd" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="refs" target="data"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-do" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="data" target="ov"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-run-unit" value="runs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;exitX=0.5;exitY=1;entryX=0.9;entryY=0;" edge="1" parent="1" source="run" target="grp-unit"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="readers" value='&lt;b&gt;Readers&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;open_grid_dataset (ours or external repos); xpublish tiles / EDR; zonal_means → Arrow batches&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#363636;" vertex="1" parent="1"><mxGeometry x="240" y="420" width="920" height="70" as="geometry"/></mxCell><mxCell id="e-read" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="grp-unit" target="readers"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="note" value="Every source runs on units; a new variable is an add-variables run over the steps already written" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="240" y="520" width="920" height="40" as="geometry"/></mxCell><mxCell id="legend" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1240" y="230" width="220" height="124" as="geometry"/></mxCell><mxCell id="legend-title" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1250" y="235" width="100" height="20" as="geometry"/></mxCell><mxCell id="legend-sw0" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1252" y="262" width="28" height="18" as="geometry"/></mxCell><mxCell id="legend-tx0" value="teehr-icechunk step" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1288" y="259" width="168" height="24" as="geometry"/></mxCell><mxCell id="legend-sw1" value="" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1252" y="290" width="28" height="18" as="geometry"/></mxCell><mxCell id="legend-tx1" value="Repo group" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1288" y="287" width="168" height="24" as="geometry"/></mxCell><mxCell id="legend-sw2" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#363636;" vertex="1" parent="1"><mxGeometry x="1252" y="318" width="28" height="18" as="geometry"/></mxCell><mxCell id="legend-tx2" value="External" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1288" y="315" width="168" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-4" name="Run model and fan-out"><mxGraphModel dx="1300" dy="640" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="640" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="parent" value='&lt;b&gt;Parent flow run&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;List, select, prepare (one commit), plan units&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="260" height="90" as="geometry"/></mxCell><mxCell id="prefect" value='&lt;b&gt;PrefectRunner ([prefect] extra)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Backfills: one child run per unit via run_deployment, at most max_child_runs at a time&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="380" y="50" width="280" height="90" as="geometry"/></mxCell><mxCell id="inproc" value="&lt;b&gt;In-process runner&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Daily runs: units one after another in the parent's pod&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="380" y="200" width="280" height="80" as="geometry"/></mxCell><mxCell id="grp-children" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeWidth=2;dashPattern=8 8;strokeColor=#363636;" vertex="1" parent="1"><mxGeometry x="740" y="30" width="500" height="300" as="geometry"/></mxCell><mxCell id="grp-children-label" value="Child runs (process-gridded-unit), one pod each" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=default;fontSize=14;fontStyle=1;fontColor=#363636;" vertex="1" parent="1"><mxGeometry x="760" y="16" width="396" height="30" as="geometry"/></mxCell><mxCell id="child0" value='&lt;b&gt;Unit 1&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Writes its chunks, commits with rebase over the other units&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="770" y="70" width="440" height="60" as="geometry"/></mxCell><mxCell id="e-pf-c0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363