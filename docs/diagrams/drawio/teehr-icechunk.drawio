ltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="700" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="refs" value='&lt;b&gt;/references&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Virtual chunks pointing into the source files; always written&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="260" height="110" as="geometry"/></mxCell><mxCell id="data" value='&lt;b&gt;/data&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Optional materialized copy, rechunked and sharded for fast reads&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="60" width="260" height="110" as="geometry"/></mxCell><mxCell id="ov" value='&lt;b&gt;/overviews/&amp;lt;factor&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Block means for zoomed-out map tiles, e.g. 2, 4, 8&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="720" y="60" width="260" height="110" as="geometry"/></mxCell><mxCell id="e-rd" value="materialize&lt;br&gt;(stale steps)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="refs" target="data"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-do" value="overviews of the&lt;br&gt;data group" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;" edge="1" parent="1" source="data" target="ov"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dg" value="Readers use the root &lt;b&gt;data_group&lt;/b&gt; attribute: /data when materialized, else /references" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="940" height="30" as="geometry"/></mxCell><mxCell id="dims" value='&lt;b&gt;Dims&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;&lt;b&gt;Analysis:&lt;/b&gt; (time, y, x) or (time, feature_id)&lt;br&gt;&lt;b&gt;Forecast:&lt;/b&gt; (reference_time, [member], lead_time, y, x)&lt;br&gt;lead_time in int hours; value_time is a 2-D coordinate on (reference_time, lead_time)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="460" height="120" as="geometry"/></mxCell><mxCell id="steps" value='&lt;b&gt;Per-step metadata (coordinates on the step dims)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;&lt;b&gt;status&lt;/b&gt;: -2 not expected, -1 unwritten, 0 early, 1 provisional, 2 stable&lt;br&gt;&lt;b&gt;created_at, updated_at, source_last_modified&lt;/b&gt;: drive upserts and downstream staleness&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="520" y="250" width="460" height="120" as="geometry"/></mxCell><mxCell id="attrs" value='&lt;b&gt;Root attributes&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;append_dim, time_origin, time_step (the fixed time grid); fixed_dims, layout_version; configuration_name, timeseries_type, grid_name, data_group&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="940" height="80" as="geometry"/></mxCell><mxCell id="grid" value="Every step has a slot on the fixed time grid (time_origin + k × time_step), so steps can be written in any order, rewritten (upsert), and resumed after a failed run" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="940" height="40" as="geometry"/></mxCell><mxCell id="spec" value="Defined in spec/gridded-repo-contract.md; tests/fixtures/*_golden.json pin what each shape stores" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="940" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>