 as="geometry"/></mxCell><mxCell id="record" value='&lt;b&gt;Parent records steps&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;For units that succeeded; failed units stay unwritten and the next run retries them&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="220" height="110" as="geometry"/></mxCell><mxCell id="e-p-pf" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;exitX=1;exitY=0.4;entryX=0;entryY=0.5;" edge="1" parent="1" source="parent" target="prefect"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-p-in" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="parent" target="inproc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-in-repo" value="chunk commits" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;exitX=0.5;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="inproc" target="repo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-c-repo" value="chunk commits" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="grp-children" target="repo"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990" y="485"/></Array></mxGeometry></mxCell><mxCell id="e-p-rec" value="after the units" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#363636;fontSize=11;labelBackgroundColor=default;exitX=